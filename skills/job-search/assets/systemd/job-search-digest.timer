[Unit]
Description=Daily timer for the job search morning digest

[Timer]
# 08:30 leaves the 06:00 discovery run over two hours to finish, so the digest
# reports on this morning's finds rather than yesterday's.
OnCalendar=*-*-* 08:30:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
