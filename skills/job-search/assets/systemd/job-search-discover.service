[Unit]
Description=Job search pipeline: daily discovery (scan saved-job sources, research, tracker sync)

# Template: install-orchestrator.sh fills in @SKILL_DIR@. The jobs repo is found through
# ~/.config/job-search/paths.env (see scripts/paths.sh), which the installer writes.

[Service]
Type=oneshot
ExecStart=@SKILL_DIR@/scripts/orchestrator.sh discover
# Type=oneshot inherits DefaultTimeoutStartSec (commonly 90s), which would kill a run
# mid-research. Allow up to 2h; the lockfile prevents overlap if one truly hangs.
TimeoutStartSec=7200
